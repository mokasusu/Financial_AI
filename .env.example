# Financial_AI - Mẫu cấu hình biến môi trường
# Sao chép tệp này thành .env và điền các giá trị thực tế của bạn.
# Tuyệt đối không commit file .env chứa giá trị bí mật lên kho mã nguồn.

# Cấu hình đường dẫn Tesseract OCR trên Windows (tùy chọn)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Cấu hình AI Provider (Giai đoạn 2: Vision AI Qwen2.5-VL qua OpenRouter)
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# OPENROUTER_MODEL=qwen/qwen-2.5-vl-7b-instruct:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
